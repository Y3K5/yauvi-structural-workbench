{
  "schema_version": "2.0",
  "collection_id": "yauvi-structural-public-qualification-v2",
  "manifest_state": "source_adoption_required",
  "immutability_policy": "Thresholds, expected labels, splits, and adopted source checksums are never edited in place. A scientific change requires a new collection version.",
  "execution_policy": {
    "network_access": "forbidden",
    "software_tests_are_separate": true,
    "independent_second_machine_required": true,
    "predicted_structures_allowed_for_state_atlas": false
  },
  "release_blocking_scopes": [
    "structure_qc:coordinate_provenance_and_validation",
    "membrane_orientation:beta_barrel",
    "conformational_state:abl_family",
    "functional_site_state:curated_functional_site_mapping",
    "assembly_interface:deposited_biological_assembly",
    "sf_csa:curated_structure_sequence_comparison"
  ],
  "non_blocking_scopes": [
    "membrane_orientation:alpha_helical",
    "conformational_state:other_proteins"
  ],
  "panels": [
    {
      "workflow": "membrane_orientation",
      "panel_id": "qualification-v2-membrane",
      "requirements": [
        {
          "record_kind": "benchmark_case",
          "stratum": "beta_barrel",
          "split": "development",
          "count": 8
        },
        {
          "record_kind": "benchmark_case",
          "stratum": "beta_barrel",
          "split": "held_out",
          "count": 8
        },
        {
          "record_kind": "benchmark_case",
          "stratum": "alpha_helical",
          "split": "development",
          "count": 8
        },
        {
          "record_kind": "benchmark_case",
          "stratum": "alpha_helical",
          "split": "held_out",
          "count": 8
        }
      ],
      "coverage_rules": [
        "Alpha-helical cases must include single-pass, multipass, oligomeric, and insufficient-flank controls.",
        "Development and held-out records cannot share a PDB entry or close-homolog group."
      ],
      "gates": {
        "mean_unsigned_normal_error_deg_max": 15.0,
        "per_case_unsigned_normal_error_deg_max": 30.0,
        "mean_half_thickness_error_A_max": 2.5,
        "non_vacuous_residue_jaccard_min": 0.95,
        "normal_drift_across_20_rotations_deg_max": 1.0,
        "empty_extracellular_comparison": "not_applicable"
      },
      "records": []
    },
    {
      "workflow": "conformational_state",
      "panel_id": "qualification-v2-abl-state-atlas",
      "requirements": [
        {
          "record_kind": "reference",
          "stratum": "active",
          "split": "reference",
          "count": 2
        },
        {
          "record_kind": "reference",
          "stratum": "inactive",
          "split": "reference",
          "count": 4
        },
        {
          "record_kind": "benchmark_case",
          "stratum": "active",
          "split": "held_out",
          "count": 4
        },
        {
          "record_kind": "benchmark_case",
          "stratum": "inactive",
          "split": "held_out",
          "count": 8
        }
      ],
      "coverage_rules": [
        "Reference and held-out records must cover at least eight distinct PDB entries.",
        "Every comparison uses an exact SIFTS or explicit residue-equivalence map over UniProt ABL1 242-495 with at least 90 percent coverage.",
        "Every reference has experimental provenance and independent state evidence."
      ],
      "gates": {
        "max_best_reference_rmsd_A": 2.5,
        "minimum_opposite_state_margin_A": 0.25,
        "confident_opposite_state_calls_max": 0,
        "correct_interpretable_coverage_per_state_min": 0.8
      },
      "records": []
    },
    {
