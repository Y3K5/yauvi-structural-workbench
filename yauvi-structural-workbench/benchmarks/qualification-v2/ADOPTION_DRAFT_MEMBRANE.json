{
  "schema_version": "1.0",
  "draft_state": "not_adopted",
  "panel_id": "qualification-v2-membrane",
  "workflow": "membrane_orientation",
  "stratum": "beta_barrel",
  "policy": "A draft covering the beta_barrel stratum only. The alpha_helical stratum is explicitly non-blocking for Mark 1 and its v1 result failed the normal-error gate, so it is curated separately.",
  "gate_semantics": {
    "membrane_orientation": {
      "mean_half_thickness_error_A_max": 2.5,
      "mean_unsigned_normal_error_deg_max": 1.0,
      "per_case_unsigned_normal_error_deg_max": 2.0,
      "normal_drift_across_8_rotations_deg_max": 1.0,
      "non_vacuous_residue_jaccard_min": 0.95,
      "minimum_reference_extracellular_residues": 10,
      "reference": "OPM, which distributes structures already oriented on Z and records its fitted half-thickness as a REMARK in the file.",
      "note": "The panel now asks two independent questions and both are gated at 1.0 degree: accuracy against OPM (mean_unsigned_normal_error_deg_max) and reproducibility under rotation (normal_drift_across_5_rotations_deg_max). They are different quantities and a case can fail either alone -- 1BXW is 6.19 degrees from OPM on x86_64 while drifting only 0.015 degrees under rotation, and 2F1C sits 5.6 degrees from OPM on arm64 while drifting 5.09. The accuracy bound was 15.0 degrees in collection 2.0, which sat inside the failure mode and passed 1QD6 on arm64 at 8.391 degrees; see threshold_revisions. Note that memorient's own validation.normal_threshold_deg has always been 1.0 degree on the error, so the panel now holds the workflow to the standard the module itself declares rather than to one fifteen times looser.",
      "vacuity_note": "A Jaccard over an empty reference set is 1.0 and means nothing, so a minimum extracellular reference size is required before the floor applies. 1THQ was excluded for carrying only 7 reference residues."
    },
    "missing_evidence_behavior": {
      "mode": "fail_closed",
      "expected_missing_by_stratum": {
        "beta_barrel": [
          "external_opm_ppm_benchmark_adoption"
        ]
      },
      "rule": "The run's missing-evidence list must equal the stratum's declared expectation.",
      "note": "memorient reports external_opm_ppm_benchmark_adoption missing on every run: it is a constant in the CLI, not a state check. It is therefore declared expected. The consequence worth recording is that the module cannot signal the opposite -- this panel IS the OPM adoption, and memorient will keep reporting the benchmark unadopted after it is adopted, because nothing connects the two. Making that flag conditional on an adopted source record is an open defect, not something this panel can fix by curation."
    },
    "coverage_requirements": {
      "mode": "witnessed_by_at_least_one_executed_case",
      "required_features": [
        "beta_barrel_scope",
        "extracellular_comparison_evaluated",
        "rotation_series_recorded",
        "non_trivial_normal_error",
        "embedded_residues_identified",
        "lipid_pore_gap_positive"
      ],
      "rationale": "non_trivial_normal_error is the load-bearing one: fifteen of the sixteen structures recover OPM's normal to about 0.0001 degrees, so a panel without 1BXW would test the gate against nothing but exact agreement and could not distinguish a working fit from one that returns the input orientation unchanged."
    }
  },
