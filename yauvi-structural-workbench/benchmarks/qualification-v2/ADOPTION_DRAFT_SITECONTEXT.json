{
  "schema_version": "1.0",
  "draft_state": "not_adopted",
  "panel_id": "qualification-v2-site-context",
  "workflow": "functional_site_state",
  "policy": "A draft. Nothing is adopted; PANEL_MANIFEST.json is unchanged.",
  "gate_semantics": {
    "functional_site": {
      "false_exact_mappings_max": 0,
      "unambiguous_curated_residue_recovery_min": 0.95,
      "recovery_floor_exempt_strata": [
        "apo_modified_or_incomplete"
      ],
      "cofactor_identifier_match": "exact",
      "missing_state_accuracy": "exact",
      "note": "The recovery floor is written for complete structures. The apo/modified/incomplete stratum exists to carry structures whose curated residues cannot all be resolved -- 1ALG resolves none of five -- so applying the floor there would fail the stratum for doing its job. Those cases are held to their declared per-site states instead, which is the stricter test.",
      "cofactor_declaration_source": "UniProt COFACTOR annotation, joined to PDB component ids through an explicit ChEBI table. Declaring from UniProt rather than from the coordinate file is what makes the gate non-vacuous: a cofactor the structure lacks is still declared and reported not_observed.",
      "component_map_note": "Every case supplies the ChEBI-to-component map, not only the metal stratum. Without it a declared cofactor resolves to \"unresolved\" rather than \"not_observed\", which would let an apo or fragment structure look merely unmapped instead of missing its cofactor."
    },
    "missing_evidence_behavior": {
      "mode": "fail_closed",
      "expected_missing_by_stratum": {
        "acid_base": [
          "pocket_results"
        ],
        "nucleophile_or_covalent": [
          "pocket_results"
        ],
        "metal_or_cofactor": [
          "pocket_results"
        ],
        "apo_modified_or_incomplete": [
          "pocket_results"
        ]
      },
      "rule": "No pocket predictor is run, so every case reports pocket_results missing. Declared per stratum so the absence is stated, not tolerated."
    }
  },
