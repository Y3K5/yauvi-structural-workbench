  "measured_on": {
    "date": "2026-08-26",
    "python": "3.12.7",
    "note": "Expectations are measured outputs of the current StructQC, recorded so a future run can be compared against them. They are not independent ground truth."
  },
  "gate_semantics": {
    "residue_identity": {
      "mode": "matches_declared_expectation",
      "tolerance": 1e-06,
      "alternatives": {
        "matches_declared_expectation": "The computed identity must equal the value declared for the case. A declared engineered mutation is expected to lower identity, and failing to lower it is the defect.",
        "equals_one": "Identity must be 1.0 for every case. Disqualifies every structure carrying an engineered mutation, including 2V7A, and with it the panel's only nonstandard-residue coverage."
      },
      "chosen_because": "2V7A measures 0.996296, which is exactly 1 - 1/270: the single declared T315I difference and nothing else. Detecting a declared mutation is the behaviour under test, so the gate asserts the measurement matches what the case declares."
    },
    "official_metric_import": {
      "mode": "exact",
      "by_stratum": {
        "x_ray": {
          "evidence_source": "wwpdb_validation_report",
          "required_metrics": [
            "clashscore",
            "ramachandran_outliers_percent",
            "rotamer_outliers_percent"
          ]
        },
        "alphafold": {
          "evidence_source": "alphafold_db_confidence",
          "required_metrics": [],
          "required_confidence": [
            "state",
            "mean_angstrom",
            "max_angstrom",
            "size"
          ],
          "note": "No wwPDB validation report exists for a predicted model. The official confidence evidence is pLDDT in the B-factor column plus the PAE matrix, so the gate checks those instead of geometry-validation metrics."
        }
      }
    },
    "missing_evidence_behavior": {
      "mode": "fail_closed",
      "expected_missing_by_stratum": {
        "x_ray": [],
        "alphafold": [
          "community_geometry_validation"
        ]
      },
      "rule": "The run's missing-evidence list must equal the stratum's declared expectation. Evidence that cannot exist for a stratum is declared, not silently tolerated; anything else appearing there is a change that must be noticed.",
      "detail": "Exit 1 is a scientifically-incomplete result carrying its reason, not a failure."
    }
  },
