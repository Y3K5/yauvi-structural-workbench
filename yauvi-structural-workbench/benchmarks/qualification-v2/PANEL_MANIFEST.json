      "gate_semantics": {
        "residue_identity": {
          "mode": "matches_declared_expectation",
          "tolerance": 1e-06,
          "alternatives": {
            "matches_declared_expectation": "The computed identity must equal the value declared for the case. A declared engineered mutation is expected to lower identity, and failing to lower it is the defect.",
            "equals_one": "Identity must be 1.0 for every case. Disqualifies every structure carrying an engineered mutation, including 2V7A, and with it the panel's only nonstandard-residue coverage."
          },
          "chosen_because": "2V7A measures 0.996296, which is exactly 1 - 1/270: the single declared T315I difference and nothing else. Detecting a declared mutation is the behaviour under test, so the gate asserts the measurement matches what the case declares."
        },
        "official_metric_import": {
          "mode": "exact",
          "required_metrics": [
            "clashscore",
            "ramachandran_outliers_percent",
            "rotamer_outliers_percent"
          ]
        },
        "missing_evidence_behavior": {
          "mode": "fail_closed",
          "detail": "Exit 1 is a scientifically-incomplete result carrying its reason, not a failure."
        }
