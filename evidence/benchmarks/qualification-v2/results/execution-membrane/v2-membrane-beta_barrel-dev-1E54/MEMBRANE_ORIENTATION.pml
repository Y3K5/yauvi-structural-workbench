# memorient oriented view
# context=gram_negative_om method=barrel_normal label=barrel
load oriented.pdb, mol
hide everything, mol
show cartoon, mol
bg_color white
set cartoon_transparency, 0.1
set_color acc_periplasmic, [0.835, 0.369, 0.000]
select periplasmic, mol and resi 2+3+46+47+48+49+50+250+251+401+402+404+407+408+2+3+46+47+48+49+50+250+251+401+402+404+407+408+2+3+46+47+48+49+50+250+251+401+402+404+407+408
color acc_periplasmic, periplasmic
set_color acc_pore_lumen_facing, [0.000, 0.447, 0.698]
select pore_lumen_facing, mol and resi 
color acc_pore_lumen_facing, pore_lumen_facing
set_color acc_lipid_embedded, [0.941, 0.894, 0.259]
select lipid_embedded, mol and resi 
color acc_lipid_embedded, lipid_embedded
set_color acc_lps_shielded, [0.337, 0.706, 0.914]
select lps_shielded, mol and resi 
color acc_lps_shielded, lps_shielded
set_color acc_antibody_accessible, [0.902, 0.624, 0.000]
select antibody_accessible, mol and resi 21+22+23+123+161+162+163+164+166+197+229+230+231+232+233+234+235+266+267+268+299+300+316+317+318+21+22+23+123+161+162+163+164+166+197+229+230+231+232+233+234+235+266+267+268+299+300+316+317+318+21+22+23+123+161+162+163+164+166+197+229+230+231+232+233+234+235+266+267+268+299+300+316+317+318
color acc_antibody_accessible, antibody_accessible
set_color acc_buried_interior, [0.600, 0.600, 0.600]
select buried_interior, mol and resi 165+195+196+198+199+200+201+236+269+301+165+195+196+198+199+200+201+236+269+301+165+195+196+198+199+200+201+236+269+301
color acc_buried_interior, buried_interior
select epitope_surface, mol and resi 21+22+23+123+161+162+163+164+166+197+229+230+231+232+233+234+235+266+267+268+299+300+316+317+318+21+22+23+123+161+162+163+164+166+197+229+230+231+232+233+234+235+266+267+268+299+300+316+317+318+21+22+23+123+161+162+163+164+166+197+229+230+231+232+233+234+235+266+267+268+299+300+316+317+318
show sticks, epitope_surface
pseudoatom mem_ec, pos=[0,0,13.9]
pseudoatom mem_peri, pos=[0,0,-13.9]
# membrane core spans z = [-13.9, 13.9]; extracellular is +z
orient mol
zoom mol, 5
