# memorient oriented view
# context=gram_negative_om method=barrel_normal label=surface
load oriented.pdb, mol
hide everything, mol
show cartoon, mol
bg_color white
set cartoon_transparency, 0.1
set_color acc_lps_shielded, [0.337, 0.706, 0.914]
select lps_shielded, mol and resi 1+2+3+4+5+51+52+53+54+55+76+77+78+79+100+101+102+103+104+124+125+126+127+148+149+150+151+205+206+207+208+230+231+232+270+271+272+273+297+298+299+300+301+321+322+323+349+350+351+352+353+363+364+365+366+391+392+393+394+407+408+409+410+411
color acc_lps_shielded, lps_shielded
set_color acc_pore_lumen_facing, [0.000, 0.447, 0.698]
select pore_lumen_facing, mol and resi 6+8+9+11+15+17+20+23+25+26+29+31+32+35+36+39+40+42+44+46+50+81+83+85+87+97+99+129+131+133+135+141+147+210+214+222+224+226+228+274+276+278+280+290+292+294+296+324+326+328+332+340+342+346+348+368+370+374+376+382+384+388+390+412+416+418+420
color acc_pore_lumen_facing, pore_lumen_facing
set_color acc_lipid_embedded, [0.941, 0.894, 0.259]
select lipid_embedded, mol and resi 
color acc_lipid_embedded, lipid_embedded
set_color acc_periplasmic, [0.835, 0.369, 0.000]
select periplasmic, mol and resi 41+89+90+91+136+137+138+139+140+216+217+218+219+220+221+281+282+283+284+285+286+287+288+334+335+336+337+338+378+379+422+423+424+425+426+427
color acc_periplasmic, periplasmic
set_color acc_buried_interior, [0.600, 0.600, 0.600]
select buried_interior, mol and resi 
color acc_buried_interior, buried_interior
set_color acc_antibody_accessible, [0.902, 0.624, 0.000]
select antibody_accessible, mol and resi 59+61+63+64+65+69+71+72+75+107+109+111+122+152+154+164+169+171+172+173+174+177+178+179+180+182+183+184+186+187+189+190+192+196+201+203+204+234+236+238+242+244+245+246+249+250+251+252+253+256+259+260+261+262+263+264+266+268+302+305+309+310+311+312+313+316+318+354+355+396+398+400+401+403+405
color acc_antibody_accessible, antibody_accessible
select epitope_surface, mol and resi 59+61+63+64+65+69+71+72+75+107+109+111+122+152+154+164+169+171+172+173+174+177+178+179+180+182+183+184+186+187+189+190+192+196+201+203+204+234+236+238+242+244+245+246+249+250+251+252+253+256+259+260+261+262+263+264+266+268+302+305+309+310+311+312+313+316+318+354+355+396+398+400+401+403+405
show sticks, epitope_surface
pseudoatom mem_ec, pos=[0,0,11.6]
pseudoatom mem_peri, pos=[0,0,-11.6]
# membrane core spans z = [-11.6, 11.6]; extracellular is +z
orient mol
zoom mol, 5
