# memorient oriented view
# context=gram_negative_om method=barrel_normal label=barrel
load oriented.pdb, mol
hide everything, mol
show cartoon, mol
bg_color white
set cartoon_transparency, 0.1
set_color acc_lipid_embedded, [0.941, 0.894, 0.259]
select lipid_embedded, mol and resi 
color acc_lipid_embedded, lipid_embedded
set_color acc_pore_lumen_facing, [0.000, 0.447, 0.698]
select pore_lumen_facing, mol and resi 21+24+30+38+71+73+75+76+79+85+87+92+119+123+125+127+132+134+135+137+159+161+163+165+170+172+174+196+198+202+205+207+209+211+228+232+233+234+238+265+266+21+24+38+71+73+75+76+79+87+92+119+123+125+127+132+134+135+137+161+163+165+170+172+174+198+202+205+207+209+211+228+232+234+238+240+265+266
color acc_pore_lumen_facing, pore_lumen_facing
set_color acc_lps_shielded, [0.337, 0.706, 0.914]
select lps_shielded, mol and resi 
color acc_lps_shielded, lps_shielded
set_color acc_antibody_accessible, [0.902, 0.624, 0.000]
select antibody_accessible, mol and resi 44+46+47+50+51+54+55+57+60+61+63+64+101+103+104+149+150+181+183+184+186+187+190+218+219+220+255+46+47+50+51+54+55+57+60+61+63+64+101+103+104+149+150+180+181+183+186+187+190+217+218+219+220+245+253+255
color acc_antibody_accessible, antibody_accessible
set_color acc_buried_interior, [0.600, 0.600, 0.600]
select buried_interior, mol and resi 
color acc_buried_interior, buried_interior
set_color acc_periplasmic, [0.835, 0.369, 0.000]
select periplasmic, mol and resi 84
color acc_periplasmic, periplasmic
select epitope_surface, mol and resi 44+46+47+50+51+54+55+57+60+61+63+64+101+103+104+149+150+181+183+184+186+187+190+218+219+220+255+46+47+50+51+54+55+57+60+61+63+64+101+103+104+149+150+180+181+183+186+187+190+217+218+219+220+245+253+255
show sticks, epitope_surface
pseudoatom mem_ec, pos=[0,0,12.0]
pseudoatom mem_peri, pos=[0,0,-12.0]
# membrane core spans z = [-12.0, 12.0]; extracellular is +z
orient mol
zoom mol, 5
