# memorient oriented view
# context=gram_negative_om method=barrel_normal label=barrel
load oriented.pdb, mol
hide everything, mol
show cartoon, mol
bg_color white
set cartoon_transparency, 0.1
set_color acc_pore_lumen_facing, [0.000, 0.447, 0.698]
select pore_lumen_facing, mol and resi 
color acc_pore_lumen_facing, pore_lumen_facing
set_color acc_lipid_embedded, [0.941, 0.894, 0.259]
select lipid_embedded, mol and resi 
color acc_lipid_embedded, lipid_embedded
set_color acc_lps_shielded, [0.337, 0.706, 0.914]
select lps_shielded, mol and resi 
color acc_lps_shielded, lps_shielded
set_color acc_periplasmic, [0.835, 0.369, 0.000]
select periplasmic, mol and resi 36+37+36+37+36+37
color acc_periplasmic, periplasmic
set_color acc_antibody_accessible, [0.902, 0.624, 0.000]
select antibody_accessible, mol and resi 144+145+173+174+175+177+213+216+218+219+221+223+225+226+228+255+256+258+287+288+144+145+173+174+175+177+213+216+218+219+221+223+225+226+228+255+256+287+288+144+145+173+174+175+177+213+216+218+219+221+223+225+226+228+255+256+258+287+288
color acc_antibody_accessible, antibody_accessible
set_color acc_buried_interior, [0.600, 0.600, 0.600]
select buried_interior, mol and resi 172+176+178+179+180+206+207+208+209+210+211+212+214+215+217+220+222+224+227+254+257+286+172+176+178+179+180+206+207+208+209+210+211+212+214+215+217+220+222+224+227+254+257+258+286+172+176+178+179+180+206+207+208+209+210+211+212+214+215+217+220+222+224+227+254+257+286
color acc_buried_interior, buried_interior
select epitope_surface, mol and resi 144+145+173+174+175+177+213+216+218+219+221+223+225+226+228+255+256+258+287+288+144+145+173+174+175+177+213+216+218+219+221+223+225+226+228+255+256+287+288+144+145+173+174+175+177+213+216+218+219+221+223+225+226+228+255+256+258+287+288
show sticks, epitope_surface
pseudoatom mem_ec, pos=[0,0,13.7]
pseudoatom mem_peri, pos=[0,0,-13.7]
# membrane core spans z = [-13.7, 13.7]; extracellular is +z
orient mol
zoom mol, 5
